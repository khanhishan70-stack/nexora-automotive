# === YouTube (Google Cloud Console) ===
# 1. Create a project, enable "YouTube Data API v3"
# 2. OAuth consent screen (External, add yourself as test user)
# 3. Create OAuth client ID (Web application), add authorized redirect:
#    http://localhost:5174/api/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: server API key for higher quota (search works with either)
YOUTUBE_API_KEY=
YOUTUBE_REDIRECT_URI=http://localhost:5174/api/oauth/youtube/callback

# === Instagram (Meta for Developers) ===
# 1. Create an app, add "Facebook Login" product
# 2. Valid OAuth redirect URIs:
#    http://localhost:5174/api/oauth/instagram/callback
# 3. Only professional/creator accounts linked to a Page can grant
#    instagram_basic access. Public Reel browsing is NOT supported by Meta.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5174/api/oauth/instagram/callback

# === Google Sign-In (for auto-connect) ===
# 1. Same Google Cloud project as YouTube (or separate)
# 2. OAuth consent screen, add scopes: openid, email, profile
# 3. Create OAuth client ID (Web application), add authorized redirect:
#    http://localhost:5174/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/api/oauth/google/callback

# === App security ===
# Change this to a long random string in production (encrypts stored tokens)
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# === Server ===
PORT=5174
SYNC_INTERVAL_MS=300000